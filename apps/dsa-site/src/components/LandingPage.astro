      <!-- BALANCED 3x2 DOCS LAUNCH GRID -->
      <section class="space-y-5">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <div class="text-xs font-semibold uppercase tracking-wider mono-num" style="color: var(--ob-accent);">03 / DOCUMENTATION</div>
