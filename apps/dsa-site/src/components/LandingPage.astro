---
import '../styles/landing.css';
import siteMeta from '../data/site-meta.json';
import zhSignals from '../data/daily_signals.json';
import enSignals from '../data/daily_signals.us.json';

interface Props {
  lang: 'zh' | 'en';
}

const { lang } = Astro.props;
const isEn = lang === 'en';
const rawSignals = isEn ? enSignals : zhSignals;

// Format sanitized sample records for the interactive Hero Stage (no synthetic scores)
const stageSamples = (Array.isArray(rawSignals) ? rawSignals : []).slice(0, 4).map((item, idx) => {
  const score = Number(item.sentiment_score ?? 60);
  const marketMap: Record<string, string> = {
    cn: isEn ? 'A-Share' : 'A股',
    hk: isEn ? 'HK' : '港股',
    us: isEn ? 'US' : '美股',
  };
  const market = marketMap[String(item.market || '').toLowerCase()] || (item.market || 'Stock');
  const sp = (item.sniper_points || {}) as Record<string, number | null | undefined>;
  const fmt = (v: number | null | undefined) => (typeof v === 'number' ? v.toFixed(2) : '—');
  const dt = String(item.decision_type || 'hold').toLowerCase();
  const catalysts = (Array.isArray(item.positive_catalysts) ? item.positive_catalysts : []).filter(
    (entry): entry is string => typeof entry === 'string' && entry.trim().length > 0,
  );
  const risks = (Array.isArray(item.risk_alerts) ? item.risk_alerts : []).filter(
    (entry): entry is string => typeof entry === 'string' && entry.trim().length > 0,
  );

  return {
    code: item.code || `STK${idx}`,
    name: item.name || item.code || '-',
    market,
    sector: item.sector || (isEn ? 'Equity' : '行业'),
    score,
    scoreDesc:
      score >= 70
        ? isEn
          ? 'Constructive momentum'
          : '景气多头偏强'
        : score >= 50
          ? isEn
            ? 'Watch & discipline'
            : '谨慎观察区间'
          : isEn
            ? 'Risk-off caution'
            : '注意波动风控',
    advice: item.operation_advice || (isEn ? 'Watch' : '观望'),
    decisionType: dt,
    trend: item.trend_prediction || (isEn ? 'Bullish' : '看多'),
    confidence: item.confidence_level || (isEn ? 'Medium' : '中'),
    summary: item.analysis_summary || '-',
    catalysts: catalysts.length ? catalysts : ['-'],
    risks: risks.length ? risks : ['-'],
    idealBuy: fmt(sp.ideal_buy),
    secBuy: fmt(sp.secondary_buy),
    stopLoss: fmt(sp.stop_loss),
    takeProfit: fmt(sp.take_profit),
    model: item.model_used || 'openai-compatible/gemini',
    dataSources: item.data_sources || (isEn ? 'Multi-source market & news' : '行情 + 新闻舆情 + 技术面 + 基本面'),
  };
});

const shortVersion = (siteMeta.versionLabel || 'v3.35.0').split('-')[0];
const docsBase = isEn ? '/en/docs' : '/docs';
const localizeDoc = (path: string) => `${isEn ? '/en' : ''}${path}`;

const quickstartChannels = isEn
  ? [
      {
        id: 'desktop',
        label: 'Desktop App (0-Code)',
        desc: 'Electron installer for Windows / macOS with full WebUI built in.',
        docHref: localizeDoc('/docs/getting-started/beginner-client/'),
        codeTitle: 'Desktop App · Windows / macOS',
        code: `# 1. Download installer from GitHub Releases (no Python setup needed)
https://github.com/ZhuLinsen/daily_stock_analysis/releases

# 2. Open Settings inside the app and fill:
STOCK_LIST=AAPL,NVDA,hk00700,600519
GEMINI_API_KEY=...   # or OPENAI_API_KEY / ANTHROPIC_API_KEY

# 3. Click "Analyze Now" to generate your first Decision Dashboard`,
      },
      {
        id: 'actions',
        label: 'GitHub Actions',
        desc: 'Zero infrastructure cost, scheduled daily delivery on trading days.',
        docHref: localizeDoc('/docs/getting-started/quick-start/'),
        codeTitle: 'GitHub Actions · Serverless Workflow',
        code: `# 1. Fork https://github.com/ZhuLinsen/daily_stock_analysis
# 2. Repo Settings -> Secrets and variables -> Actions -> New secret:
GEMINI_API_KEY=...        # or DEEPSEEK_API_KEY / ANTHROPIC_API_KEY (for OpenAI gateways also set OPENAI_BASE_URL + OPENAI_MODEL)
STOCK_LIST=AAPL,NVDA,hk00700
TELEGRAM_BOT_TOKEN=...    # Telegram requires BOTH TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID
TELEGRAM_CHAT_ID=...      # or DISCORD_WEBHOOK_URL, or EMAIL_SENDER + EMAIL_PASSWORD

# 3. Enable Workflows -> Run "Daily Stock Analysis" manually to test`,
      },
      {
        id: 'docker',
        label: 'Docker Compose',
        desc: '24x7 self-hosted container with FastAPI, React WebUI, and scheduler.',
        docHref: localizeDoc('/docs/deployment/docker/'),
        codeTitle: 'Docker Compose · Server Deployment',
        code: `git clone https://github.com/ZhuLinsen/daily_stock_analysis.git
cd daily_stock_analysis
cp .env.example .env
# Edit .env: set STOCK_LIST and at least one AI API key

docker-compose -f ./docker/docker-compose.yml up -d server
# Open http://127.0.0.1:8000`,
      },
      {
        id: 'local',
        label: 'Local Python',
        desc: 'Best for debugging providers, LLM routers, strategies, and backtests.',
        docHref: localizeDoc('/docs/deployment/local/'),
        codeTitle: 'Python 3.10+ · CLI & WebUI',
        code: `git clone https://github.com/ZhuLinsen/daily_stock_analysis.git && cd daily_stock_analysis
python -m venv .venv && source .venv/bin/activate
pip install -r requirements.txt && cp .env.example .env
# Edit .env: set STOCK_LIST and at least one AI key (e.g. GEMINI_API_KEY or DEEPSEEK_API_KEY)

python main.py --doctor                    # offline health diagnostics
python main.py --stocks AAPL,NVDA --serve  # analyze + start WebUI`,
      },
    ]
  : [
      {
        id: 'desktop',
        label: '桌面客户端 (0 代码)',
        desc: 'Windows / macOS 安装包开箱即用，内置完整工作台与配置向导。',
        docHref: localizeDoc('/docs/getting-started/beginner-client/'),
        codeTitle: 'Electron 桌面端 · Windows / macOS 一键安装',
        code: `# 1. 前往 GitHub Releases 下载安装包（无需配置 Python 环境）
https://github.com/ZhuLinsen/daily_stock_analysis/releases

# 2. 打开客户端 →「设置」页填入：
STOCK_LIST=600519,hk00700,AAPL,7203.T
GEMINI_API_KEY=...   # 或 DeepSeek / OpenAI 兼容 / Claude Key

# 3. 回到首页点击「立即分析」，30 秒内生成首份决策仪表盘`,
      },
      {
        id: 'actions',
        label: 'GitHub Actions',
        desc: '零服务器成本，每个交易日 18:00 自动研判并推送到微信/飞书/TG/邮箱。',
        docHref: localizeDoc('/docs/deployment/github-actions/'),
        codeTitle: 'GitHub Actions · 零服务器定时推送',
        code: `# 1. Fork 仓库：https://github.com/ZhuLinsen/daily_stock_analysis
# 2. 进入 Settings -> Secrets and variables -> Actions -> New repository secret

GEMINI_API_KEY=...        # 或 MODELFLARE_KEY / DEEPSEEK_API_KEY（OpenAI 兼容网关需加配 BASE_URL 与 MODEL）
STOCK_LIST=600519,hk00700,AAPL
WECHAT_WEBHOOK_URL=...    # 或 FEISHU_WEBHOOK_URL / DISCORD_WEBHOOK_URL
# Telegram 需成对配置：TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID
# 邮件需成对配置：EMAIL_SENDER + EMAIL_PASSWORD

# 3. Actions 标签页启用 Workflow -> 手动点击 Run workflow 测试`,
      },
      {
        id: 'docker',
        label: 'Docker Compose',
        desc: '适合云服务器或 NAS 长期托管，一键拉起 WebUI、API 与定时调度。',
        docHref: localizeDoc('/docs/deployment/docker/'),
        codeTitle: 'Docker Compose · 自托管服务端',
        code: `git clone https://github.com/ZhuLinsen/daily_stock_analysis.git
cd daily_stock_analysis
cp .env.example .env      # 编辑填写 STOCK_LIST 与 AI Key

docker-compose -f ./docker/docker-compose.yml up -d server
# 浏览器访问 http://127.0.0.1:8000`,
      },
      {
        id: 'local',
        label: '本地 Python',
        desc: '适合开发者调试大模型路由、数据源优先级、自定义策略与回测。',
        docHref: localizeDoc('/docs/deployment/local/'),
        codeTitle: 'Python 3.10+ · CLI 与本地诊断',
        code: `git clone https://github.com/ZhuLinsen/daily_stock_analysis.git && cd daily_stock_analysis
python -m venv .venv && source .venv/bin/activate
pip install -r requirements.txt && cp .env.example .env
# 编辑 .env：填写 STOCK_LIST 与至少一个 AI Key（如 GEMINI_API_KEY / DEEPSEEK_API_KEY / MODELFLARE_KEY）

python main.py --doctor                     # 离线检查环境与数据源就绪度
python main.py --stocks 600519,hk00700,AAPL # 立即分析指定标的
python main.py --serve                      # 启动 Web 工作台（8000 端口）`,
      },
    ];

const docCards = isEn
  ? [
      { tag: 'START', title: 'Quick Start & Runtimes', desc: 'Compare Desktop App, GitHub Actions, Docker, and CLI in one view.', href: localizeDoc('/docs/getting-started/quick-start/') },
      { tag: 'MARKETS', title: '6-Market Support Matrix', desc: 'Coverage and fallback rules for A-shares, HK, US, JP, KR, TW, and ETFs.', href: localizeDoc('/docs/features/market-support/') },
      { tag: 'LLM', title: 'LLM Router & Models', desc: 'Configure Gemini, Claude, DeepSeek, OpenAI-compatible gateways, and Ollama.', href: localizeDoc('/docs/configuration/llm-guide/') },
      { tag: 'DATA', title: 'Data Sources & TickPlus', desc: 'Priority chains, circuit breakers, TickPlus, Tushare, and Longbridge setup.', href: localizeDoc('/docs/configuration/data-sources/') },
      { tag: 'BOTS', title: 'Notifications & Bots', desc: 'Connect WeChat Work, Feishu, DingTalk, Telegram, Discord, Slack, and Email.', href: localizeDoc('/docs/configuration/bot-commands/') },
      { tag: 'OPENAPI', title: `OpenAPI Explorer (${siteMeta.apiEndpointCount})`, desc: 'Searchable viewer for the curated static OpenAPI 3.1 snapshot (docs/architecture/api_spec.json).', href: localizeDoc('/docs/reference/api/') },
    ]
  : [
      { tag: 'START', title: '选择运行方式（快速开始）', desc: '桌面端、GitHub Actions、Docker 与本地 CLI 四路径对比与 5 分钟上手。', href: '/docs/getting-started/quick-start/' },
      { tag: 'MARKETS', title: '6 大市场支持边界', desc: '明确 A 股、港股、美股、日股、韩股、台股及 ETF 的字段可用性与降级规则。', href: '/docs/features/market-support/' },
      { tag: 'LLM', title: 'LLM 大模型路由配置', desc: '接入 Gemini、Claude、DeepSeek、OpenAI 兼容网关、Ollama 本地模型与 LiteLLM。', href: '/docs/configuration/llm-guide/' },
      { tag: 'DATA', title: '数据源稳定性与 TickPlus', desc: '多源 Fallback 优先级、短期熔断恢复与 TickPlus / Tushare / Longbridge 指南。', href: '/docs/configuration/data-sources/' },
      { tag: 'BOTS', title: '通知渠道与 Bot 平台', desc: '企业微信、飞书、钉钉、Telegram、Discord、Slack、邮件与 OpenClaw / Grok 集成。', href: '/docs/configuration/notifications/' },
      { tag: 'OPENAPI', title: `OpenAPI 接口浏览器 (${siteMeta.apiEndpointCount})`, desc: '交互式检索主仓静态 OpenAPI 3.1 架构快照（docs/architecture/api_spec.json）中的核心端点与 Schema。', href: '/docs/reference/api/' },
    ];

const initialSample = stageSamples[0];
---

<!doctype html>
<html lang={isEn ? 'en' : 'zh-CN'} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('starlight-theme');
          const theme = saved === 'light' ? 'light' : 'dark';
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
    <title>
      {isEn
        ? 'DSA - LLM-Driven Multi-Market Stock Analysis System'
        : 'DSA - LLM 驱动的多市场智能股票分析系统'}
    </title>
    <meta
      name="description"
      content={isEn
        ? 'Open-source LLM stock analysis across A-shares, HK, US, JP, KR, and TW markets with decision dashboards, 20 Agent strategies, backtesting, and multi-channel delivery.'
        : '基于 AI 大模型的 A股/港股/美股/日股/韩股/台股智能分析系统，提供每日决策仪表盘、大盘复盘、20 种 Agent 策略问股、告警风控与多渠道推送。'}
    />
    <link rel="canonical" href={isEn ? 'https://dsa.zhulinsen.tech/en/' : 'https://dsa.zhulinsen.tech/'} />
    <link rel="alternate" hreflang="zh-CN" href="https://dsa.zhulinsen.tech/" />
    <link rel="alternate" hreflang="en" href="https://dsa.zhulinsen.tech/en/" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Daily Stock Analysis" />
    <meta property="og:title" content="Daily Stock Analysis (DSA)" />
    <meta property="og:image" content="https://dsa.zhulinsen.tech/assets/dsa-webui.png" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <!-- Top Sticky Minimalist Header -->
    <header
      class="sticky top-0 z-40 border-b backdrop-blur-md"
      style="border-color: var(--ob-border); background: color-mix(in srgb, var(--ob-bg) 82%, transparent);"
    >
      <div class="max-w-[1180px] mx-auto px-4 sm:px-6 h-15 flex items-center justify-between gap-4">
        <div class="flex items-center gap-7">
          <a href={isEn ? '/en/' : '/'} class="flex items-center gap-2.5 no-underline" style="color: var(--ob-ink);">
            <svg viewBox="0 0 36 32" class="w-6 h-6 shrink-0" aria-hidden="true">
              <rect x="2" y="20" width="6" height="10" rx="2" fill="#EA4335" />
              <rect x="11" y="13" width="6" height="10" rx="2" fill="#FBBC05" />
              <rect x="11" y="25" width="6" height="5" rx="2" fill="#FBBC05" />
              <rect x="20" y="7" width="6" height="6" rx="2" fill="#34A853" />
              <rect x="20" y="15" width="6" height="6" rx="2" fill="#34A853" />
              <rect x="20" y="23" width="6" height="7" rx="2" fill="#34A853" />
              <rect x="29" y="2" width="6" height="11" rx="2" fill="#4285F4" />
              <rect x="29" y="15" width="6" height="8" rx="2" fill="#4285F4" />
              <rect x="29" y="25" width="6" height="5" rx="2" fill="#4285F4" />
            </svg>
            <span class="font-bold text-sm tracking-tight">DSA</span>
            <span class="hidden sm:inline text-xs" style="color: var(--ob-muted);">Daily Stock Analysis</span>
          </a>

          <nav class="hidden md:flex items-center gap-6 text-xs font-medium" style="color: var(--ob-muted);">
            <a href="#stage" class="no-underline hover:opacity-80" style="color: inherit;">{isEn ? 'Product' : '产品体验'}</a>
            <a href="#capabilities" class="no-underline hover:opacity-80" style="color: inherit;">{isEn ? 'Capabilities' : '核心能力'}</a>
            <a href="#quickstart" class="no-underline hover:opacity-80" style="color: inherit;">{isEn ? 'Quick Start' : '快速开始'}</a>
            <a href={`${docsBase}/`} class="no-underline hover:opacity-80" style="color: inherit;">{isEn ? 'Docs' : '文档中心'}</a>
          </nav>
        </div>

        <div class="flex items-center gap-2">
          <a
            href={`${docsBase}/`}
            class="hidden sm:inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border text-xs no-underline transition"
            style="border-color: var(--ob-border); background: var(--ob-surface); color: var(--ob-muted);"
          >
            <span>{isEn ? 'Search Docs' : '搜索文档'}</span>
            <kbd class="mono-num text-[11px] px-1.5 py-0.5 rounded" style="background: var(--ob-surface-soft); color: var(--ob-ink);">⌘K</kbd>
          </a>

          <a
            href={isEn ? '/' : '/en/'}
            class="px-2.5 py-1.5 rounded-lg border text-xs font-medium no-underline transition"
            style="border-color: var(--ob-border); background: var(--ob-surface); color: var(--ob-muted);"
            title={isEn ? '切换到简体中文' : 'Switch to English'}
          >
            {isEn ? '中文' : 'EN'}
          </a>

          <button
            type="button"
            id="themeToggleBtn"
            class="w-8 h-8 rounded-lg border flex items-center justify-center cursor-pointer transition text-sm"
            style="border-color: var(--ob-border); background: var(--ob-surface); color: var(--ob-ink);"
            aria-label={isEn ? 'Toggle theme' : '切换明暗主题'}
          >
            <span id="themeIconSun" class="hidden">☀</span>
            <span id="themeIconMoon">☾</span>
          </button>

          <a
            href="https://github.com/ZhuLinsen/daily_stock_analysis"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border text-xs font-semibold no-underline transition"
            style="border-color: var(--ob-border); background: var(--ob-surface); color: var(--ob-ink);"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.67 0 8.2c0 3.63 2.29 6.7 5.47 7.79.4.08.55-.18.55-.4 0-.2-.01-.86-.01-1.56-2.01.38-2.53-.5-2.69-.96-.09-.24-.48-.96-.82-1.15-.28-.16-.68-.55-.01-.56.63-.01 1.08.59 1.23.84.72 1.24 1.87.89 2.33.68.07-.53.28-.89.51-1.09-1.78-.21-3.64-.91-3.64-4.04 0-.89.31-1.62.82-2.19-.08-.21-.36-1.04.08-2.16 0 0 .67-.22 2.2.84A7.42 7.42 0 0 1 8 3.96c.68 0 1.36.09 2 .28 1.53-1.06 2.2-.84 2.2-.84.44 1.12.16 1.95.08 2.16.51.57.82 1.3.82 2.19 0 3.14-1.87 3.83-3.65 4.04.29.26.54.75.54 1.52 0 1.09-.01 1.97-.01 2.24 0 .22.15.48.55.4A8.12 8.12 0 0 0 16 8.2C16 3.67 12.42 0 8 0Z" />
            </svg>
            <span class="hidden sm:inline">GitHub</span>
          </a>

          <button
            type="button"
            id="mobileMenuBtn"
            class="md:hidden w-8 h-8 rounded-lg border flex items-center justify-center cursor-pointer"
            style="border-color: var(--ob-border); background: var(--ob-surface); color: var(--ob-ink);"
            aria-label="Menu"
            aria-expanded="false"
          >
            ☰
          </button>
        </div>
      </div>

      <!-- Mobile Nav Drawer -->
      <div id="mobileMenuDrawer" class="hidden md:hidden border-t px-4 py-3 space-y-2 text-xs" style="border-color: var(--ob-border); background: var(--ob-bg);">
        <a href="#stage" class="block py-1.5 no-underline" style="color: var(--ob-ink);">{isEn ? 'Product Preview' : '产品体验'}</a>
        <a href="#capabilities" class="block py-1.5 no-underline" style="color: var(--ob-ink);">{isEn ? 'Capabilities' : '核心能力'}</a>
        <a href="#quickstart" class="block py-1.5 no-underline" style="color: var(--ob-ink);">{isEn ? 'Quick Start' : '快速开始'}</a>
        <a href={`${docsBase}/`} class="block py-1.5 no-underline font-semibold" style="color: var(--ob-accent);">{isEn ? 'Documentation Center' : '文档中心'}</a>
      </div>
    </header>

    <main class="max-w-[1180px] mx-auto px-4 sm:px-6 pt-12 pb-16 space-y-16">
      <!-- HERO SECTION -->
      <section class="text-center space-y-6">
        <!-- Trust Badges -->
        <div class="flex flex-wrap items-center justify-center gap-2 text-xs">
          <a
            href="https://github.com/ZhuLinsen/daily_stock_analysis/releases"
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1 rounded-full border font-medium mono-num no-underline"
            style="border-color: var(--ob-border-strong); background: var(--ob-accent-soft); color: var(--ob-accent);"
          >
            {shortVersion}
          </a>
          <a
            href="https://arxiv.org/abs/2608.26990"
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1 rounded-full border font-medium mono-num no-underline"
            style="border-color: var(--ob-border); background: var(--ob-surface); color: var(--ob-muted);"
          >
            arXiv:2608.26990
          </a>
          <span
            class="px-3 py-1 rounded-full border font-medium"
            style="border-color: var(--ob-border); background: var(--ob-surface); color: var(--ob-muted);"
          >
            {isEn ? '6 Markets · A / HK / US / JP / KR / TW' : '6 大市场 · A / H / US / JP / KR / TW'}
          </span>
          <span
            class="px-3 py-1 rounded-full border font-medium"
            style="border-color: var(--ob-border); background: var(--ob-surface); color: var(--ob-muted);"
          >
            MIT Open Source
          </span>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-6xl font-bold tracking-tight leading-[1.1] max-w-4xl mx-auto" style="color: var(--ob-ink);">
          {isEn ? (
            <>
              LLM-Driven{' '}
              <span style="color: var(--ob-accent);">Decision Dashboards</span>
              <br />
              for Every Trading Day
            </>
          ) : (
            <>
              让大模型每天为你完成
              <br />
              <span style="color: var(--ob-accent);">自选股决策研判</span>与大盘复盘
            </>
          )}
        </h1>

        <p class="text-sm sm:text-lg leading-relaxed max-w-2xl mx-auto" style="color: var(--ob-muted);">
          {isEn
            ? 'Synthesize multi-source quotes, live financial news, technicals, and 20 built-in Agent strategies. Deploy in 5 minutes via Desktop App, GitHub Actions, or Docker.'
            : '聚合多源行情、实时金融新闻、筹码技术面与 20 种 Agent 交易策略。无需昂贵服务器，5 分钟通过桌面客户端、GitHub Actions 或 Docker 跑通每日推送闭环。'}
        </p>

