          <a href={`${docsBase}/`} class="ob-secondary-btn px-4 py-2 text-xs font-semibold no-underline">
            {isEn ? 'Enter Docs Center →' : '进入文档中心 →'}
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {docCards.map((card) => (
            <a href={card.href} class="ob-card ob-card-hover p-5 flex flex-col justify-between gap-4 no-underline">
              <div class="space-y-2.5">
                <span
                  class="inline-block px-2 py-0.5 rounded text-[11px] font-semibold mono-num"
                  style="background: var(--ob-accent-soft); color: var(--ob-accent);"
                >
                  {card.tag}
                </span>
                <h3 class="text-base font-semibold m-0" style="color: var(--ob-ink);">{card.title}</h3>
                <p class="text-xs leading-relaxed m-0" style="color: var(--ob-muted);">{card.desc}</p>
              </div>
              <span class="text-xs font-medium" style="color: var(--ob-accent);">{isEn ? 'Read doc →' : '阅读文档 →'}</span>
            </a>
          ))}
        </div>
      </section>

      <!-- ALPHA ECOSYSTEM MATRIX -->
      <section class="space-y-4">
        <div class="text-xs font-semibold uppercase tracking-wider mono-num" style="color: var(--ob-muted);">
          04 / ALPHA OPEN-SOURCE MATRIX
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="ob-card p-5 border-l-4" style="border-left-color: var(--ob-accent);">
            <div class="text-xs font-semibold mono-num" style="color: var(--ob-accent);">CORE · {isEn ? 'DAILY ANALYSIS' : '每日研判'}</div>
            <h3 class="text-base font-bold mt-1.5 mb-0" style="color: var(--ob-ink);">Daily Stock Analysis</h3>
            <p class="text-xs mt-1.5 mb-0 leading-relaxed" style="color: var(--ob-muted);">
              {isEn ? 'Watchlist tracking, decision dashboards, market reviews, and Agent Q&A.' : '自选股跟踪、决策仪表盘、大盘复盘与 Agent 多策略问股。'}
            </p>
          </div>
          <div class="ob-card ob-card-hover p-5 flex flex-col justify-between gap-3">
            <div>
              <div class="text-xs font-semibold mono-num" style="color: var(--ob-muted);">ECOSYSTEM · {isEn ? 'STOCK DISCOVERY' : '全市场选股'}</div>
              <h3 class="text-base font-bold mt-1.5 mb-0" style="color: var(--ob-ink);">AlphaSift</h3>
              <p class="text-xs mt-1.5 mb-0 leading-relaxed" style="color: var(--ob-muted);">
                {isEn
                  ? 'Automated multi-market daily stock screening with auditable YAML strategies and public T+N paper-tracked performance.'
                  : '自动化多市场每日选股、可审计 YAML 策略与公开 T+N 纸面跟踪（A 股可选公告排雷与 AI 复核）。'}
              </p>
            </div>
            <div class="flex flex-wrap items-center gap-3 pt-1 text-xs font-semibold">
              <a
                href={isEn
                  ? 'https://alphasift.zhulinsen.tech/?lang=en&utm_source=dsa_site'
                  : 'https://alphasift.zhulinsen.tech/?lang=zh&utm_source=dsa_site'}
                target="_blank"
                rel="noopener noreferrer"
                class="no-underline hover:underline"
                style="color: var(--ob-accent-strong);"
              >
                {isEn ? 'Daily Picks ↗' : '在线今日榜单 ↗'}
              </a>
              <a
                href="https://github.com/ZhuLinsen/alphasift"
                target="_blank"
                rel="noopener noreferrer"
                class="no-underline hover:underline"
                style="color: var(--ob-muted);"
              >
                GitHub ↗
              </a>
            </div>
          </div>
          <a
            href="https://github.com/ZhuLinsen/alphaevo"
            target="_blank"
            rel="noopener noreferrer"
            class="ob-card ob-card-hover p-5 no-underline block"
          >
            <div class="text-xs font-semibold mono-num" style="color: var(--ob-muted);">ECOSYSTEM · {isEn ? 'STRATEGY EVOLUTION' : '策略进化'}</div>
            <h3 class="text-base font-bold mt-1.5 mb-0" style="color: var(--ob-ink);">AlphaEvo ↗</h3>
            <p class="text-xs mt-1.5 mb-0 leading-relaxed" style="color: var(--ob-muted);">
              {isEn ? 'Self-evolving strategy backtesting and iterative parameter research agent.' : '策略回测验证与自适应参数进化引擎，与 DSA 形成投研闭环。'}
            </p>
          </a>
        </div>
      </section>
    </main>

    <!-- FOOTER -->
    <footer class="border-t py-8" style="border-color: var(--ob-border);">
      <div class="max-w-[1180px] mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs" style="color: var(--ob-muted);">
        <div class="space-y-1">
          <div class="font-semibold" style="color: var(--ob-ink);">Daily Stock Analysis · MIT License</div>
          <p class="m-0">
            {isEn
              ? 'Research and automation tool only — does not constitute investment advice.'
              : '本项目仅供学习与研究辅助使用，不构成任何投资建议。'}
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-4">
          <a href={`${docsBase}/`} class="no-underline hover:underline" style="color: var(--ob-accent);">{isEn ? 'Docs' : '文档中心'}</a>
          <a href={localizeDoc('/docs/reference/api/')} class="no-underline hover:underline" style="color: var(--ob-muted);">OpenAPI</a>
          <a href="https://github.com/ZhuLinsen/daily_stock_analysis/issues" target="_blank" rel="noopener noreferrer" class="no-underline hover:underline" style="color: var(--ob-muted);">Issues</a>
          <a href="mailto:zhuls345@gmail.com?subject=DSA%20Feedback" class="no-underline hover:underline" style="color: var(--ob-muted);">zhuls345@gmail.com</a>
        </div>
      </div>
    </footer>

    <script is:inline define:vars={{ stageSamples, quickstartChannels, isEn }}>
      (() => {
        // Theme Sync with Starlight
        const themeBtn = document.getElementById('themeToggleBtn');
        const sunIcon = document.getElementById('themeIconSun');
        const moonIcon = document.getElementById('themeIconMoon');

        function applyTheme(t) {
          document.documentElement.dataset.theme = t;
          try {
            localStorage.setItem('starlight-theme', t);
          } catch {}
          if (sunIcon && moonIcon) {
            sunIcon.classList.toggle('hidden', t !== 'dark');
            moonIcon.classList.toggle('hidden', t === 'dark');
          }
        }

        applyTheme(document.documentElement.dataset.theme === 'light' ? 'light' : 'dark');

        themeBtn?.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
          applyTheme(next);
        });

        // Mobile Drawer
        const menuBtn = document.getElementById('mobileMenuBtn');
        const drawer = document.getElementById('mobileMenuDrawer');
        menuBtn?.addEventListener('click', () => {
          const open = drawer?.classList.toggle('hidden') === false;
          menuBtn.setAttribute('aria-expanded', String(open));
        });

        // Sample Stage Switching
        const sampleBtns = Array.from(document.querySelectorAll('.sample-tab-btn'));
        function styleSampleButtons(activeIdx) {
          sampleBtns.forEach((btn, i) => {
            const active = i === activeIdx;
            btn.style.background = active ? 'var(--ob-accent-soft)' : 'var(--ob-surface-2)';
            btn.style.color = active ? 'var(--ob-accent)' : 'var(--ob-muted)';
            btn.style.borderColor = active ? 'var(--ob-border-strong)' : 'var(--ob-border)';
          });
        }
        styleSampleButtons(0);

        sampleBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const idx = Number(btn.dataset.sampleIdx || 0);
            const s = stageSamples[idx];
            if (!s) return;
            styleSampleButtons(idx);
            const set = (id, val) => {
              const el = document.getElementById(id);
              if (el) el.textContent = val;
            };
            set('stageModel', s.model);
            set('stageMarket', s.market);
            set('stageSector', s.sector);
            set('stageCode', s.code);
            set('stageName', s.name);
            set('stageAdvice', `${isEn ? 'Advice' : '建议'} · ${s.advice}`);
            set('stageTrend', `${isEn ? 'Trend' : '趋势'} · ${s.trend}`);
            set('stageConf', `${isEn ? 'Confidence' : '置信度'} · ${s.confidence}`);
            set('stageScore', String(s.score));
            set('stageScoreDesc', s.scoreDesc);
            set('stageSummary', s.summary);
            set('stageDataSources', s.dataSources);
            set('stageIdealBuy', s.idealBuy);
            set('stageSecBuy', s.secBuy);
            set('stageStopLoss', s.stopLoss);
            set('stageTakeProfit', s.takeProfit);
            set('stageDecisionType', s.decisionType);
            set('stageContextModel', s.model);
            set('stageContextSources', s.dataSources);

            const renderBullets = (id, items) => {
              const listEl = document.getElementById(id);
              if (!listEl) return;
              listEl.replaceChildren();
              (items || ['-']).forEach((entry) => {
                const li = document.createElement('li');
                li.textContent = String(entry);
                listEl.appendChild(li);
              });
            };
            renderBullets('stageCatalysts', s.catalysts);
            renderBullets('stageRisks', s.risks);

            const adviceEl = document.getElementById('stageAdvice');
            if (adviceEl) {
              adviceEl.style.color =
                s.decisionType === 'buy' ? 'var(--ob-up)' : s.decisionType === 'sell' ? 'var(--ob-down)' : 'var(--ob-warn)';
            }
            const arc = document.getElementById('stageGaugeArc');
            if (arc) {
              arc.style.strokeDashoffset = (150.8 * (1 - s.score / 100)).toFixed(1);
            }
          });
        });

        // Quickstart Channel Switching + Copy
        const qsBtns = Array.from(document.querySelectorAll('.qs-tab-btn'));
        let activeQsIdx = 0;

        function styleQsButtons(activeIdx) {
          qsBtns.forEach((btn, i) => {
            const active = i === activeIdx;
            btn.style.background = active ? 'var(--ob-accent-soft)' : 'var(--ob-surface-2)';
            btn.style.color = active ? 'var(--ob-accent)' : 'var(--ob-muted)';
            btn.style.borderColor = active ? 'var(--ob-border-strong)' : 'var(--ob-border)';
          });
        }
        styleQsButtons(0);

        qsBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            activeQsIdx = Number(btn.dataset.qsIdx || 0);
            const ch = quickstartChannels[activeQsIdx];
            if (!ch) return;
            styleQsButtons(activeQsIdx);
            const desc = document.getElementById('qsDesc');
            const link = document.getElementById('qsDocLink');
            const title = document.getElementById('qsCodeTitle');
            const body = document.getElementById('qsCodeBody');
            if (desc) desc.textContent = ch.desc;
            if (link) link.setAttribute('href', ch.docHref);
            if (title) title.textContent = ch.codeTitle;
            if (body) body.textContent = ch.code;
          });
        });

        const copyBtn = document.getElementById('qsCopyBtn');
        copyBtn?.addEventListener('click', async () => {
          const text = quickstartChannels[activeQsIdx]?.code || '';
          try {
            if (navigator.clipboard?.writeText) {
              await navigator.clipboard.writeText(text);
            } else {
              const ta = document.createElement('textarea');
              ta.value = text;
              document.body.appendChild(ta);
              ta.select();
              document.execCommand('copy');
              document.body.removeChild(ta);
            }
          } catch {}
          const orig = copyBtn.textContent;
          copyBtn.textContent = isEn ? 'Copied ✓' : '已复制 ✓';
          setTimeout(() => {
            copyBtn.textContent = orig;
          }, 1500);
        });
      })();
    </script>
  </body>
</html>
