{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Design contract for Ben-facing English-only dashboards, PDFs, PNG exports, and notification cards generated by Daily Stock Analysis agents.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.043,
          0.071,
          0.125
        ],
        "hex": "#0b1220"
      }
    },
    "on-primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.973,
          0.98,
          0.988
        ],
        "hex": "#f8fafc"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.973,
          0.98,
          0.988
        ],
        "hex": "#f8fafc"
      }
    },
    "surface-raised": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "surface-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.933,
          0.957,
          0.973
        ],
        "hex": "#eef4f8"
      }
    },
    "text-primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.043,
          0.071,
          0.125
        ],
        "hex": "#0b1220"
      }
    },
    "text-secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.278,
          0.333,
          0.412
        ],
        "hex": "#475569"
      }
    },
    "text-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.392,
          0.455,
          0.545
        ],
        "hex": "#64748b"
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.847,
          0.878,
          0.918
        ],
        "hex": "#d8e0ea"
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.055,
          0.455,
          0.565
        ],
        "hex": "#0e7490"
      }
    },
    "on-accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.973,
          0.98,
          0.988
        ],
        "hex": "#f8fafc"
      }
    },
    "positive": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.016,
          0.471,
          0.341
        ],
        "hex": "#047857"
      }
    },
    "negative": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.725,
          0.11,
          0.11
        ],
        "hex": "#b91c1c"
      }
    },
    "warning": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.706,
          0.325,
          0.035
        ],
        "hex": "#b45309"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.886,
          0.91,
          0.941
        ],
        "hex": "#e2e8f0"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 40,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 20,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 2.5,
          "unit": "rem"
        },
        "fontWeight": 700
      }
    },
    "title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 1.5,
          "unit": "rem"
        },
        "fontWeight": 650
      }
    },
    "section": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 650
      }
    },
    "metric": {
      "$type": "typography",
      "$value": {
        "fontFamily": "JetBrains Mono",
        "fontSize": {
          "value": 1.75,
          "unit": "rem"
        },
        "fontWeight": 700
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 0.95,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 0.78,
          "unit": "rem"
        },
        "fontWeight": 500
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 0.72,
          "unit": "rem"
        },
        "fontWeight": 700
      }
    }
  }
}
