# Daily Stock Analysis (DSA) · 60 秒极简配置
# 完成第 1、2 步即可运行，也可用 python main.py --init 生成配置。

# 1) 自选股列表（支持 A股/港股/美股/日股/韩股/台股，逗号分隔）
STOCK_LIST=600519,hk00700,AAPL

# 2) AI 模型（任选一个提供商，取消注释该提供商的配置并填入 Key）
# MODELFLARE_KEY=
# GEMINI_API_KEY=

# DeepSeek 官方（取消注释整个区块，只需填写 LLM_DEEPSEEK_API_KEY）
# LLM_CHANNELS=deepseek
# LLM_DEEPSEEK_PROTOCOL=deepseek
# LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_DEEPSEEK_API_KEY=
# LLM_DEEPSEEK_MODELS=deepseek-flash

# AIHUBMIX_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Ollama 本地模型（先运行 ollama pull qwen2.5:14b，再取消注释以下三行）
# OLLAMA_API_BASE=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:14b
# LITELLM_MODEL=ollama/qwen2.5:14b

# 3) 推送通知（可选，Telegram 需同时填写 Token 和 Chat ID）
# WECHAT_WEBHOOK_URL=
# FEISHU_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=

# 先确认目标 .env 不存在，或已备份原文件，再复制并填写配置：
#   cp .env.minimal.example .env
#   python main.py --dry-run --no-market-review  # 测试行情抓取而不消耗 AI 配额
#   python main.py --serve-only                 # 启动 WebUI 工作台
# 完整参数参考：.env.example  |  文档索引：docs/INDEX.md
