# ==========================================================
# Daily Stock Analysis (DSA) - 60 秒极简配置模板 (.env.minimal.example)
# ==========================================================
# 只需完成第 1、2 步即可运行；其余 100+ 项高级参数均有安全默认值。
# 也可以直接运行向导生成：python main.py --init
# ==========================================================

# 1) 自选股列表（支持 A股/港股/美股/日股/韩股/台股，逗号分隔）
STOCK_LIST=600519,hk00700,AAPL

# 2) AI 模型（任选其中 1 项取消注释并填入 Key 即可；默认启用内置免费行情源）
# MODELFLARE_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# AIHUBMIX_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# 3) 推送通知（全部可选；未配置时报告仍保存至 WebUI / reports/ 目录）
# WECHAT_WEBHOOK_URL=
# FEISHU_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=

# ==========================================================
# 常用下一步：
#   cp .env.minimal.example .env       # 复制为正式配置后填入上面 1 个 Key
#   python main.py --dry-run          # 测试行情抓取而不消耗 AI 配额
#   python main.py --serve-only       # 启动 WebUI 工作台 (http://127.0.0.1:8000)
#   python main.py --stocks 600519    # 单次分析
# 完整参数参考：.env.example  |  文档索引：docs/INDEX.md
# ==========================================================
