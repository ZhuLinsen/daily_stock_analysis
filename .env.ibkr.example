# Claude-first US stock analysis example
# Copy values into GitHub Actions Variables/Secrets or a local .env file.
# Never commit real API keys.

# ===== Required secret =====
ANTHROPIC_API_KEY=

# ===== Claude model routing =====
GENERATION_BACKEND=litellm
LITELLM_MODEL=anthropic/claude-sonnet-4-6
ANTHROPIC_MODEL=claude-sonnet-4-6
LLM_TEMPERATURE=0.4

# ===== US watchlist =====
STOCK_LIST=AAPL,MSFT,NVDA,GOOGL,AMZN,META,SPY,QQQ
MARKET_REVIEW_REGION=us
MARKET_REVIEW_ENABLED=true
REPORT_LANGUAGE=en
REPORT_TYPE=simple
REPORT_SHOW_LLM_MODEL=true
SINGLE_STOCK_NOTIFY=false
TRADING_DAY_CHECK_ENABLED=true
MAX_WORKERS=1

# ===== Optional search/news =====
TAVILY_API_KEYS=
# BRAVE_API_KEYS=
# SERPAPI_API_KEYS=

# ===== Optional email notification =====
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECEIVERS=
EMAIL_SENDER_NAME=Daily Stock Analysis

# This setup is research-only. It does not place orders in IBKR.
